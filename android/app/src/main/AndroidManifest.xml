<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game only uses SDL2's software/GL renderer at GLES 2.0. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- SketchyMaze already has a touch-input mode (see pkg/native/touch_screen.go)
         so a touchscreen is the primary and expected input device. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Physical keyboards, mice and game controllers are all supported too
         (desktop build shares the same input code), so don't require them. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasFragileUserData="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <!-- SDL hints can be set here too, e.g.:
        <meta-data android:name="SDL_ENV.SDL_ACCELEROMETER_AS_JOYSTICK" android:value="0"/>
        -->

        <activity
            android:name="com.sketchymaze.doodle.MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
